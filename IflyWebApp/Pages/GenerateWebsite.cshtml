@page
@model IflyWebApp.Pages.GenerateWebsiteModel
@{
    ViewData["Title"] = "Generate Website";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>Website Generator</h2>
            <p class="text-muted">
                Generate websites using securely stored API keys. No sensitive data in configuration files!
            </p>

            @if (!Model.IsConfigured)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>Configuration Required:</strong> 
                    Please <a href="/Admin/KeyConfiguration">configure your API keys</a> before generating websites.
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert @(Model.IsError ? "alert-danger" : "alert-success")" role="alert">
                    @Model.Message
                </div>
            }

            @if (Model.IsConfigured)
            {
                <form method="post">
                    <div class="mb-3">
                        <label for="Title" class="form-label">Website Title</label>
                        <input type="text" class="form-control" id="Title" 
                               name="Title" value="@Model.Title" 
                               placeholder="Enter website title">
                    </div>

                    <div class="mb-3">
                        <label for="Content" class="form-label">Content</label>
                        <textarea class="form-control" id="Content" name="WebsiteContent" 
                                  rows="4" placeholder="Enter website content">@Model.WebsiteContent</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="Template" class="form-label">Template</label>
                        <select class="form-select" id="Template" name="Template">
                            <option value="standard" selected>Standard Template</option>
                            <option value="modern">Modern Template</option>
                            <option value="minimal">Minimal Template</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="Theme" class="form-label">Theme</label>
                        <select class="form-select" id="Theme" name="Theme">
                            <option value="light" selected>Light Theme</option>
                            <option value="dark">Dark Theme</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Generate Website</button>
                        <a href="/" class="btn btn-secondary">Back to Home</a>
                    </div>
                </form>
            }

            @if (!string.IsNullOrEmpty(Model.GeneratedWebsite))
            {
                <div class="mt-4">
                    <h4>Generated Website Preview</h4>
                    <div class="border p-3 bg-light">
                        <iframe srcdoc="@Html.Raw(Model.GeneratedWebsite)" 
                                style="width: 100%; height: 400px; border: none;"></iframe>
                    </div>
                    
                    <div class="mt-3">
                        <h5>HTML Source</h5>
                        <pre class="bg-dark text-light p-3" style="max-height: 300px; overflow-y: auto;"><code>@Model.GeneratedWebsite</code></pre>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Security Features</h5>
                </div>
                <div class="card-body">
                    <ul class="small">
                        <li>✓ API keys stored securely on disk</li>
                        <li>✓ Keys encrypted with application-specific encryption</li>
                        <li>✓ No sensitive data in web.config</li>
                        <li>✓ Environment variable support</li>
                        <li>✓ Proper error handling and logging</li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5>Configuration Options</h5>
                </div>
                <div class="card-body">
                    <p class="small">Keys can be loaded from:</p>
                    <ul class="small">
                        <li>Environment variables</li>
                        <li>Encrypted files on disk</li>
                        <li>Azure Key Vault (extendable)</li>
                        <li>Other secure storage providers</li>
                    </ul>
                    
                    <a href="/Admin/KeyConfiguration" class="btn btn-sm btn-outline-primary">
                        Manage Keys
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>