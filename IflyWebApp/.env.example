# Sample Environment Variables for Ifly Application
# Copy this file to .env.local and update with your actual values
# NEVER commit actual secrets to source control

# Website Generation API Key
WEBSITE_API_KEY=your-website-generation-api-key-here

# Database Connection String  
DATABASE_CONNECTION=Server=localhost;Database=IflyApp;Trusted_Connection=true;

# External Service Token
EXTERNAL_SERVICE_TOKEN=your-external-service-token-here

# Application Encryption Key (generate a strong random key)
IFLY_ENCRYPTION_KEY=your-strong-encryption-key-here-32chars

# Optional: Custom key storage directory
# IFLY_KEY_STORAGE_DIR=/secure/path/to/keys

# Production Example with Azure Key Vault (when implemented)
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret